VITE_SUM_DATA_MODE=mock
# API mode requires an operator configured same-origin proxy. Never put secrets here.
# VITE_SUM_DATA_MODE=api
# VITE_SUM_API_BASE_URL=/api-proxy
# Local Reportes integration uses the Vite /api proxy to 127.0.0.1:3000.
# Or start it reproducibly with `pnpm dev:local` from client/.
# VITE_SUM_DATA_MODE=local
# VITE_SUM_API_BASE_URL=/api
# Public synthetic simulator (requires VITE_SUM_DATA_MODE=local and its own API):
# VITE_SUM_SIMULATOR=1
# VITE_SUM_API_PROXY_TARGET=http://127.0.0.1:3300
