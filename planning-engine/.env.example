# ==============================================================================
# Opción A: Amazon Bedrock con API Key (Bearer Token) — Recomendado si tienes Bedrock API Key
# ==============================================================================
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=ABSK...
# Modelos recomendados en Bedrock (Cross-Region Inference Profiles):
# - us.amazon.nova-lite-v1:0 (muy rápido y económico para créditos gratis)
# - us.amazon.nova-pro-v1:0
# - us.anthropic.claude-3-5-haiku-20241022-v1:0
SUM_BEDROCK_MODEL=us.amazon.nova-lite-v1:0

# ==============================================================================
# Opción B: Amazon Bedrock con credenciales IAM (SigV4 sin dependencias extra)
# ==============================================================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
# SUM_BEDROCK_MODEL=us.amazon.nova-lite-v1:0

# ==============================================================================
# Opción C: Router OpenAI-compatible (Groq / OpenRouter / Ollama / Bedrock Mantle)
# ==============================================================================
# SUM_LLM_BASE_URL=https://api.groq.com/openai/v1
# SUM_LLM_API_KEY=gsk_...
# SUM_LLM_MODEL=llama-3.3-70b-versatile
# SUM_LLM_TIMEOUT_MS=8000
