# Only application sources and simulator infrastructure enter Docker builds.
**
!backend/
!backend/package.json
!backend/pnpm-lock.yaml
!backend/tsconfig*.json
!backend/nest-cli.json
!backend/src/
!backend/src/**
!backend/scripts/
!backend/scripts/**
!backend/migrations/
!backend/migrations/**
!raw-types/
!raw-types/*.ts
!shared/
!shared/*.mjs
!shared/*.mts
!client/
!client/package.json
!client/pnpm-lock.yaml
!client/tsconfig*.json
!client/vite.config.ts
!client/index.html
!client/nginx.conf
!client/src/
!client/src/**
!client/public/
!client/public/**
!infra/
!infra/simulator/
!infra/simulator/**
!planning-engine/
!planning-engine/*.py
!planning-engine/pyproject.toml
!planning-engine/uv.lock
!planning-engine/normative-corpus/
!planning-engine/normative-corpus/*.json
# These exclusions override every allow rule above.
**/datos-reales/**
datos-reales/
**/node_modules/**
**/.git/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/runtime/**
**/dist/**
**/coverage/**

**/__pycache__/**
**/.venv/**
**/.pytest_cache/**
