FROM node:24.22.0-bookworm-slim@sha256:a5f4366e834695d5f363b920c104953a535d3a9864d1bdf74566a0ebe01daee5 AS build
RUN npm install --global pnpm@10.34.7
WORKDIR /app/client
COPY client/package.json client/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY client ./
COPY shared /app/shared
COPY raw-types /app/raw-types
ARG VITE_SUM_SIMULATOR=1
ARG VITE_SUM_DATA_MODE=local
ARG VITE_SUM_API_BASE_URL=/api
ENV VITE_SUM_SIMULATOR=${VITE_SUM_SIMULATOR} VITE_SUM_DATA_MODE=${VITE_SUM_DATA_MODE} VITE_SUM_API_BASE_URL=${VITE_SUM_API_BASE_URL}
RUN pnpm build

FROM nginx:1.29.5-alpine@sha256:1eff5a5f3fcf8431a0abb7eddf5471fec24e5e1905a2581aeacdb07a4479b92b
ENV SIMULATOR_HTTP_PORT=5189
COPY infra/simulator/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/client/dist /usr/share/nginx/html
EXPOSE 80
