    {
      "type": "stat",
      "title": "Accepted",
      "description": "Monotonic counter: show the last sample per series in the selected dashboard range, never the sum of cumulative samples. A zero is returned only when a run with this testid has a k6_iterations_total sample.",
      "datasource": {
        "type": "prometheus",
        "uid": "simulator-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(last_over_time({__name__=~\"k6_(enrollments_accepted|mixed_submissions_accepted|retry_initial_accepted)_total\",testid=~\"$testid\"}[$__range])) or vector(0)",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "legendFormat": "{{operation}}"
        }
      ],
      "id": 9
    },
    {
      "type": "stat",
      "title": "Section full",
      "description": "Monotonic counter: show the last sample per series in the selected dashboard range, never the sum of cumulative samples. A zero is returned only when a run with this testid has a k6_iterations_total sample.",
      "datasource": {
        "type": "prometheus",
        "uid": "simulator-prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
