{
  "id": null,
  "uid": "sum-simulator-k6",
  "title": "SUM Simulator \u00b7 k6 observability",
  "description": "Local-only observability for synthetic k6 runs. Every panel filters one explicit testid. Trend statistics are interval gauges, not run-wide recomputations. Business counters show the latest cumulative value per series within the selected time range.",
  "tags": [
    "simulator",
    "k6"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests / second",
      "description": "Request throughput from k6. A short run can produce only one sample per route, which is insufficient for rate(); use the cumulative request panel for short runs.",
      "datasource": {
        "type": "prometheus",
        "uid": "simulator-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{operation}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Highest HTTP failure rate by route (%)",
      "description": "Worst per-route HTTP failure rate reported by k6 as an interval gauge. It is not an overall weighted failure rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "simulator-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (operation, name) (k6_http_req_failed_rate{testid=~\"$testid\",operation!=\"\"}) * 100",
          "range": true,
          "instant": false,
          "editorMode": "code",
          "legendFormat": "{{operation}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "HTTP duration p95",
      "description": "Per-operation and static route-name interval gauge from k6, not a test-wide recomputation. Values are converted from seconds to milliseconds. Each line remains separate; do not aggregate percentiles across series.",
      "datasource": {
        "type": "prometheus",
        "uid": "simulator-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * k6_http_req_duration_p95{testid=~\"$testid\",operation!=\"\"}",
          "range": true,
          "instant": false,
