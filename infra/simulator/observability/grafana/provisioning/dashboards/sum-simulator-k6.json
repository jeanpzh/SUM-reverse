          "refId": "A",
          "expr": "(sum(last_over_time(k6_enrollments_accepted_total{testid=~\"$testid\"}[$__range])) or on() (0 * sum(last_over_time(k6_iterations_total{testid=~\"$testid\"}[$__range]))))",
