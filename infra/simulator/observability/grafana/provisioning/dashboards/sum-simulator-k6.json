          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(last_over_time(k6_enrollments_section_full_total{testid=~\"$testid\"}[$__range])) or on() (0 * sum(last_over_time(k6_iterations_total{testid=~\"$testid\"}[$__range]))))",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "legendFormat": "{{operation}}"
